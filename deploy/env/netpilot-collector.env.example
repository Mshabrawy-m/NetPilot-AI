# NetPilot AI - EXTERNAL LINUX COLLECTOR runtime configuration (TEMPLATE).
#
# Copy to the host OUTSIDE the repository, then fill real values from a vault:
#     sudo install -d -m 0755 /etc/netpilot
#     sudo install -m 0600 -o root -g netpilot \
#            deploy/env/netpilot-collector.env.example /etc/netpilot/collector.env
# This path is exactly what netpilot-collector.service's EnvironmentFile reads.
#
# HARD RULES (enforced by tools/run_collector.py check_configuration()):
#   * collect REFUSES to run if NETPILOT_DEMO_MODE is not false.
#   * collect REFUSES to run if either safety flag is true.
#   * The collector role DSN must be PostgreSQL; only the URL *scheme* is ever
#     echoed on error, never the DSN or its password.
#   * NEVER put NETPILOT_DB_URL_ADMIN here. The schema administrator DSN is used
#     only for the one-shot `run_collector.py init-schema` and must never be
#     reachable by the timer (the collector role has no DDL rights by design).
#
# Every value below is a PLACEHOLDER (CHANGE_ME / <from-vault>). No real
# credential, API key, or connection string belongs in this committed template.

# --- Mode: this host is the LIVE collection plane --------------------------
NETPILOT_DEMO_MODE=false

# --- Database: collector role only (least privilege) -----------------------
# Role separation is ACTIVE the moment any NETPILOT_DB_URL_* is set; `collect`
# then resolves ONLY NETPILOT_DB_URL_COLLECTOR and never falls back to another
# role or the administrator. Point it at the PERSISTENT Neon production branch
# (NOT the expiring M5 disposable branch). Keep sslmode on the endpoint.
DATABASE_URL=
NETPILOT_DB_URL_COLLECTOR=postgresql+psycopg2://netpilot_collector:CHANGE_ME@CHANGE_ME-neon-endpoint:5432/netpilot?sslmode=require

# --- PostgreSQL TLS (managed services such as Neon ALWAYS require TLS) ------
NETPILOT_PG_SSLMODE=require
# To upgrade to verify-ca / verify-full, set a CA bundle PATH only (never the
# certificate contents) and add ?sslrootcert= to the DSN:
# NETPILOT_PG_SSLROOTCERT=/etc/ssl/certs/neon-root.cacert
NETPILOT_PG_CONNECT_TIMEOUT=10
# The collector runs as a one-shot (no long-lived pool); the small per-write
# statement timeout stays at the default. Do not raise it on this host.
NETPILOT_PG_STATEMENT_TIMEOUT_MS=15000

# --- Safety gates: must remain false for a read-only collector -------------
NETPILOT_CHANGE_LOOP_ENABLED=false
NETPILOT_LAB_EXECUTION_ENABLED=false

# --- Schema management: DDL is NOT the collector's job ---------------------
NETPILOT_MANAGE_SCHEMA=false

# --- Collection cadence (keep in sync with netpilot-collector.timer) --------
# Interval MUST stay well under NETPILOT_MAX_RATE_GAP_SECONDS so derived
# counter rates remain reliable (see the timer's documented rule).
NETPILOT_COLLECT_INTERVAL=60
NETPILOT_MAX_RATE_GAP_SECONDS=300
NETPILOT_PING_TIMEOUT=5
NETPILOT_PING_COUNT=3
NETPILOT_TRACEROUTE_TIMEOUT=30

# --- Lab this collector measures (co-located Containerlab host) -------------
# collect_once() reaches nodes via `docker exec`, so the topology must be
# deployed on THIS host (containerlab deploy -t <topology>).
NETPILOT_LAB_NAME=netpilot
NETPILOT_LAB_TOPOLOGY=lab/topology.clab.yml

# --- Lock: NOT set here on purpose. netpilot-collector.service owns
#     NETPILOT_COLLECTOR_LOCK=/run/netpilot/collector.lock (its RuntimeDirectory)
#     to avoid two sources for one variable. Only export it yourself if you run
#     `collect` manually outside systemd (default <system temp>/netpilot-collector.lock).

# --- Logging: exception CLASS only is ever emitted; never the DSN -----------
NETPILOT_LOG_LEVEL=INFO
