# NetPilot AI - environment template.
# Copy to .env (never committed). All values below are defaults; the app
# runs with no .env file at all. NO REAL SECRETS BELONG IN THIS FILE.

# --- Mode -----------------------------------------------------------------
# true  = clearly labelled synthetic demo data in a separate SQLite file
#         (for machines without Docker/Containerlab)
# false = live lab mode (requires Docker + Containerlab, see README)
NETPILOT_DEMO_MODE=false

# --- Database ---------------------------------------------------------------
# Leave empty for the default local SQLite file (data/netpilot.db,
# or data/netpilot_demo.db in demo mode).
# PostgreSQL example (use a vault/secret manager for real passwords):
# DATABASE_URL=postgresql+psycopg2://netpilot:CHANGE_ME@localhost:5432/netpilot
DATABASE_URL=

# --- Collection -------------------------------------------------------------
NETPILOT_COLLECT_INTERVAL=60
NETPILOT_PING_TIMEOUT=5
NETPILOT_PING_COUNT=3
NETPILOT_TRACEROUTE_TIMEOUT=30
NETPILOT_CMD_OUTPUT_LIMIT=65536

# --- Lab --------------------------------------------------------------------
NETPILOT_LAB_NAME=netpilot
NETPILOT_LAB_TOPOLOGY=lab/topology.clab.yml

# --- Phase 2 analytics (defaults shown; see README section 12) --------------
NETPILOT_ANALYTICS_MAX_POINTS=20000
NETPILOT_MIN_POINTS_ANALYSIS=5
NETPILOT_MIN_POINTS_DETECTION=12
NETPILOT_MIN_POINTS_FORECAST=30
NETPILOT_MAX_RATE_GAP_SECONDS=300
NETPILOT_DETECTOR_WINDOW=20
NETPILOT_MAD_THRESHOLD=3.5
NETPILOT_ZSCORE_THRESHOLD=3.0
NETPILOT_ANOMALY_GROUP_WINDOW_SECONDS=300
NETPILOT_FORECAST_HORIZON=10

# --- Phase 3: Groq AI assistant (placeholders only - NO real secrets here) -
# Get a free key at https://console.groq.com and put it ONLY in your local
# (git-ignored) .env, never here and never in source code or logs.
GROQ_API_KEY=
# Model must be available on your Groq account/tier; the free catalog changes
# over time. List yours with:  python -c "import groq;print([m.id for m in groq.Groq().models.list().data])"
GROQ_MODEL=openai/gpt-oss-20b

# --- v2: authentication & RBAC (opt-in; OFF by default) --------------------
# When false the dashboard runs open (Phase 1-3 behaviour).
# When true a login is required and actions are gated by role
# (viewer < operator < admin). Only a salted PBKDF2 hash is ever stored.
NETPILOT_AUTH_ENABLED=false
NETPILOT_PBKDF2_ITERATIONS=240000
# Optional bootstrap admin created on first run when auth is enabled.
# Put the real password ONLY in your local git-ignored .env, never here.
NETPILOT_ADMIN_USER=
NETPILOT_ADMIN_PASSWORD=
GROQ_TIMEOUT=30
GROQ_MAX_RETRIES=2
# Safety bounds (no deployment exists in Phase 3 regardless of these).
NETPILOT_AI_REQUEST_MAX_CHARS=4000
NETPILOT_AI_EVIDENCE_MAX_ROWS=50
NETPILOT_AI_EVIDENCE_MAX_BYTES=8192
NETPILOT_AI_GRAPH_MAX_STEPS=12

# --- v2 Slice 6: REST/WS API (opt-in, read-only) --------------------------
# The API is a separate process; start it with:
#   python -m uvicorn api.app:app --host 127.0.0.1 --port 8000
# It reads the SAME DATABASE_URL as the dashboard (SQLite or PostgreSQL).
# When set, every /api/* route requires header: Authorization: Bearer <token>.
# Leave empty for open read-only access. Put a real token ONLY in .env.
NETPILOT_API_TOKEN=
# Optional comma-separated browser origins allowed to call the API.
NETPILOT_API_CORS_ORIGINS=

# --- v2 Slice 7: gated change loop (opt-in, OFF by default) ----------------
# Propose/approve/audit of device config changes is always available in the UI,
# but APPLYING a change additionally requires this flag AND a virtual-lab
# executor on a host that runs the lab. Leave false unless you are operating
# the Containerlab VM; a production device is never reachable from this path.
NETPILOT_CHANGE_LOOP_ENABLED=false
# How long a validated request may wait for approval before it expires.
NETPILOT_CHANGE_REQUEST_TTL_MINUTES=1440

# --- Phase 4: isolated-lab EXECUTION (opt-in, OFF by default) --------------
# A SECOND, independent gate on top of NETPILOT_CHANGE_LOOP_ENABLED. Both
# must be true, on the isolated Containerlab host, before a single
# configuration line is sent to a device. Leave false everywhere else - the
# hosted deployment and every developer machine must stay inert.
# When both gates are open the executor still refuses unless it can prove the
# target is a lab router of the configured topology, the request carries a
# named non-self human approval, and the rollback plan is verifiable.
NETPILOT_LAB_EXECUTION_ENABLED=false
# Hard timeout (seconds) for one device config operation (apply/verify).
NETPILOT_LAB_EXECUTION_TIMEOUT=30

# --- Digital Twin snapshot freshness (optional) ----------------------------
# Positive seconds = evaluate a caller-supplied capture timestamp against this
# TTL. Leave empty to keep freshness explicitly unknown. This never enables
# approval, execution, or the change loop.
NETPILOT_DIGITAL_TWIN_MAX_AGE_SECONDS=
